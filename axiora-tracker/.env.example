# Copy to .env and adjust. All values are optional except where noted.

# development | production   (production blocks demo data and enables static-file caching)
NODE_ENV=development

# Address the server listens on. Keep 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
PORT=3000

# Where the SQLite database and uploaded files live (relative to the project or absolute).
DATA_DIR=data
DB_FILE=tracker.db
UPLOAD_DIR=uploads

# Sign-in sessions: normal sign-ins end after SESSION_IDLE_MINUTES without activity and never last
# longer than SESSION_TTL_HOURS. "Remember me" sign-ins last REMEMBER_DAYS.
SESSION_IDLE_MINUTES=30
SESSION_TTL_HOURS=12
REMEMBER_DAYS=30

# Secure cookie flag: auto (when request is HTTPS) | true | false
COOKIE_SECURE=auto
# Set to true when running behind nginx/Apache/a load balancer that terminates HTTPS.
TRUST_PROXY=false

# Attachment limits.
MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=10

# First admin account: created on startup only when the database has no users.
# Remove ADMIN_PASSWORD from this file once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
